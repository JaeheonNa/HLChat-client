# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts should always use LF
*.sh text eol=lf

# JavaScript/TypeScript files should use LF
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf

# JSON files should use LF
*.json text eol=lf

# CSS/SCSS files should use LF
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf

# HTML files should use LF
*.html text eol=lf

# Markdown files should use LF
*.md text eol=lf

# Config files should use LF
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
